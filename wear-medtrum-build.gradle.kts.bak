// build.gradle.kts — Module wear-medtrum (Standalone Wear OS)
//
// Les plugins android et kotlin sont déclarés via id() sans version
// car ils sont déjà sur le classpath du projet racine (buildscript).
// C'est le même pattern que tous les modules du projet AAPS.

plugins {
    id("com.android.application")           // version gérée par le classpath racine
    id("org.jetbrains.kotlin.android")      // version gérée par le classpath racine
    alias(libs.plugins.ksp)                 // ksp n'est PAS dans le classpath racine → alias OK
    alias(libs.plugins.compose.compiler)    // idem
}

android {
    namespace  = "app.aaps.wear.medtrum"
    compileSdk = 35

    defaultConfig {
        applicationId = "app.aaps.wear.medtrum"
        minSdk        = 30
        targetSdk     = 35
        versionCode   = 1
        versionName   = "1.0.0"
    }

    buildFeatures {
        compose = true
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = "17"
    }
}

dependencies {

    // ── Wear OS ──────────────────────────────────────────────────────
    implementation(libs.androidx.wear)
    implementation(libs.com.google.android.gms.playservices.wearable)
    compileOnly(libs.com.google.android.wearable)
    implementation(libs.com.google.android.wearable.support)

    // ── Compose BOM ──────────────────────────────────────────────────
    implementation(platform(libs.androidx.compose.bom))
    implementation(libs.androidx.activity.compose)
    implementation(libs.androidx.ui)
    implementation(libs.androidx.ui.graphics)
    implementation(libs.androidx.ui.tooling.preview)
    implementation(libs.androidx.compose.foundation)
    implementation(libs.androidx.lifecycle.runtime.compose)
    implementation(libs.androidx.lifecycle.viewmodel)

    // ── Wear Compose ─────────────────────────────────────────────────
    // Ces alias doivent être ajoutés dans libs.versions.toml :
    // [versions]  wearCompose = "1.5.6"
    // [libraries] androidx-wear-compose-material   = { group = "androidx.wear.compose", name = "compose-material",   version.ref = "wearCompose" }
    //             androidx-wear-compose-foundation = { group = "androidx.wear.compose", name = "compose-foundation", version.ref = "wearCompose" }
    //             androidx-wear-compose-navigation = { group = "androidx.wear.compose", name = "compose-navigation", version.ref = "wearCompose" }
    implementation(libs.androidx.wear.compose.material)
    implementation(libs.androidx.wear.compose.foundation)
    implementation(libs.androidx.wear.compose.navigation)

    // ── Coroutines ───────────────────────────────────────────────────
    implementation(platform(libs.kotlinx.coroutines.bom))
    implementation(libs.kotlinx.coroutines.android)

    // ── Room ─────────────────────────────────────────────────────────
    implementation(libs.androidx.room.runtime)
    implementation(libs.androidx.room)
    ksp(libs.androidx.room.compiler)

    // ── DataStore ────────────────────────────────────────────────────
    implementation(libs.androidx.datastore.preferences)

    // ── Modules AAPS ─────────────────────────────────────────────────
    implementation(project(":core:interfaces"))
    implementation(project(":core:data"))
    implementation(project(":core:keys"))
    implementation(project(":pump:medtrum"))
}
